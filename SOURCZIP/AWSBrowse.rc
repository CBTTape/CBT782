/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_OPEN
    SEPARATOR
    BUTTON      ID_EDIT_COPY
    SEPARATOR
    BUTTON      ID_FILE_PAGE_SETUP
    BUTTON      ID_FILE_PRINT_PREVIEW
    BUTTON      ID_FILE_PRINT
    SEPARATOR
    BUTTON      ID_VIEW_STATISTICS
    SEPARATOR
    BUTTON      ID_EDIT_FIND
    BUTTON      ID_EDIT_FINDPREVIOUS
    BUTTON      ID_EDIT_FINDNEXT
    SEPARATOR
    BUTTON      ID_EDIT_PREVIOUSFILE
    BUTTON      ID_EDIT_PREVIOUSBLOCK
    BUTTON      ID_EDIT_GOTO
    BUTTON      ID_EDIT_NEXTBLOCK
    BUTTON      ID_EDIT_NEXTFILE
    SEPARATOR
    BUTTON      ID_VIEW_BOTH
    BUTTON      ID_VIEW_TEXTONLY
    SEPARATOR
    BUTTON      ID_VIEW_ASCII
    BUTTON      ID_VIEW_EBCDIC
    SEPARATOR
    BUTTON      ID_VIEW_SETTINGS
    SEPARATOR
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Close\tCtrl+F4",             ID_FILE_MYCLOSE
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "Page Setup...",               ID_FILE_PAGE_SETUP
        MENUITEM "Print Preview...",            ID_FILE_PRINT_PREVIEW
        MENUITEM "Print Block...",              ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "&Hex Area\tShift+Tab",        ID_EDIT_HEXAREA
        MENUITEM "&Text Area\tTab",             ID_EDIT_TEXTAREA
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",            ID_EDIT_FIND
        MENUITEM "Find &Next\tF3",              ID_EDIT_FINDNEXT
        MENUITEM "Find &Previous\tShift+F3",    ID_EDIT_FINDPREVIOUS
        MENUITEM SEPARATOR
        MENUITEM "Previous File\tShift+F7",     ID_EDIT_PREVIOUSFILE
        MENUITEM "Previous Block\tF7",          ID_EDIT_PREVIOUSBLOCK
        MENUITEM "Next Block\tF8",              ID_EDIT_NEXTBLOCK
        MENUITEM "Next File\tShift+F8",         ID_EDIT_NEXTFILE
        MENUITEM SEPARATOR
        MENUITEM "Go To...\tCtrl+G",            ID_EDIT_GOTO
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "Show Hex",                    ID_VIEW_HEX
        MENUITEM SEPARATOR
        MENUITEM "&ASCII text\tCtrl+A",         ID_VIEW_ASCII
        MENUITEM "&EBCDIC text\tCtrl+E",        ID_VIEW_EBCDIC
        MENUITEM SEPARATOR
        MENUITEM "Next Pane\tF6",               ID_NEXT_PANE
        MENUITEM "Previous Pane\tShift+F6",     ID_PREV_PANE
        MENUITEM SEPARATOR
        MENUITEM "Tape Summary...",             ID_VIEW_STATISTICS
        MENUITEM SEPARATOR
        MENUITEM "Display Font...",             ID_VIEW_DISPLAYFONT
        MENUITEM "Printer Font...",             ID_VIEW_PRINTERFONT
        MENUITEM SEPARATOR
        MENUITEM "Display Format...",           ID_VIEW_SETTINGS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "DLL Version Information...",  ID_HELP_DLLVERSIONINFORMATION
        MENUITEM "&About AWSBrowse...",         ID_APP_ABOUT
    END
END

IDR_LVRCLICK_MENU MENU 
BEGIN
    POPUP "(listview right-click context menu)"
    BEGIN
        MENUITEM "&Details...",                 ID_LVRCLICK_INFO
    END
END

IDR_DUMMYCMDS_MENU MENU 
BEGIN
    POPUP "(dummy commands menu)"
    BEGIN
        MENUITEM "(view both hex and text)",    ID_VIEW_BOTH
        MENUITEM "(view only text)",            ID_VIEW_TEXTONLY
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "F",            ID_EDIT_FIND,           VIRTKEY, CONTROL, NOINVERT
    VK_F3,          ID_EDIT_FINDNEXT,       VIRTKEY, NOINVERT
    VK_F3,          ID_EDIT_FINDPREVIOUS,   VIRTKEY, SHIFT, NOINVERT
    "G",            ID_EDIT_GOTO,           VIRTKEY, CONTROL, NOINVERT
    VK_F8,          ID_EDIT_NEXTBLOCK,      VIRTKEY, NOINVERT
    VK_F8,          ID_EDIT_NEXTFILE,       VIRTKEY, SHIFT, NOINVERT
    VK_F7,          ID_EDIT_PREVIOUSBLOCK,  VIRTKEY, NOINVERT
    VK_F7,          ID_EDIT_PREVIOUSFILE,   VIRTKEY, SHIFT, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    VK_F4,          ID_FILE_MYCLOSE,        VIRTKEY, CONTROL, NOINVERT
END


