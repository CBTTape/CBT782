IDD_ABOUTBOX DIALOG  0, 0, 269, 65
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About AWSBrowse"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "",IDC_STATIC,7,4,255,52
    ICON            IDR_MAINFRAME,IDC_STATIC,17,16,21,20
    LTEXT           "Fish's AWS File Browser Utility",IDC_PRODUCT_VERSION_STATIC,53,16,197,8
    LTEXT           "Copyright (C) 2004-2008 Software Development Laboratories",IDC_COPYRIGHT_COMPANY_STATIC,53,27,197,8
    LTEXT           "Support contact:",IDC_STATIC,53,38,54,8
    LTEXT           "fish@softdevlabs.com",IDC_CONTACT_EMAIL_STATIC,111,38,78,8
END

IDD_PROGRESS DIALOG  0, 0, 461, 57
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "Cancel",IDCANCEL,205,36,50,14
    CONTROL         "Progress1",IDC_PROGDLG_PROGRESS,"msctls_progress32",WS_BORDER,15,18,439,10
    LTEXT           " 0 %",IDC_PROGDLG_PERCENT,221,7,18,8
END

IDD_MY_FIND_DIALOG DIALOGEX  0, 0, 273, 87
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Fi&nd what:",IDC_STATIC,7,9,34,8
    CONTROL         "",IDC_FINDWHAT_COMBOBOX,"ComboBoxEx32",CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP,49,7,158,114
    GROUPBOX        "How",IDC_STATIC,8,26,90,54
    CONTROL         "Match whole &word",IDC_WHOLEWORD_CHECKBOX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,17,39,74,10
    CONTROL         "Match &case",IDC_MATCHCASE_CHECKBOX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,17,51,53,10
    CONTROL         "He&x search",IDC_HEX_CHECKBOX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,17,63,52,10
    GROUPBOX        "Where",IDC_STATIC,105,26,48,54,WS_GROUP
    CONTROL         "&Block",IDC_WHERE_RADIO_BUTTON_GROUP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,111,39,34,10
    CONTROL         "&File",IDC_FILE_RADIO_BUTTON,"Button",BS_AUTORADIOBUTTON,111,51,27,10
    CONTROL         "&Tape",IDC_TAPE_RADIO_BUTTON,"Button",BS_AUTORADIOBUTTON,111,63,33,10
    GROUPBOX        "Direction",IDC_STATIC,160,26,48,54,WS_GROUP
    CONTROL         "&Up",IDC_UPDOWN_RADIO_BUTTON_GROUP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,167,39,25,10
    CONTROL         "&Down",IDC_DOWN_RADIO_BUTTON,"Button",BS_AUTORADIOBUTTON,167,51,35,10
    DEFPUSHBUTTON   "&Find Next",IDOK,216,7,50,14,WS_DISABLED | WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,216,25,50,14
END

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 177, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Format"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    GROUPBOX        " Hex Area Layout ",IDC_STATIC,7,5,163,55,WS_GROUP
    LTEXT           "Bytes per group:",IDC_STATIC,19,22,52,8
    EDITTEXT        IDC_BPG_EDIT,76,20,19,12,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Spin1",IDC_BPG_SPINNER,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,97,20,10,12
    LTEXT           "Bytes per line:",IDC_STATIC,19,38,45,8
    EDITTEXT        IDC_BPR_EDIT,76,36,19,12,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Spin1",IDC_BPR_SPINNER,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,97,36,10,12
    CONTROL         " (dynamic)",IDC_DYN_CHECKBOX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,116,38,48,10
    GROUPBOX        " Text Area Layout ",IDC_STATIC,7,66,163,55,WS_GROUP
    LTEXT           "Record length:",IDC_STATIC,19,83,48,8
    EDITTEXT        IDC_TEXT_RECLEN_EDIT,76,81,19,12,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Spin1",IDC_RECLEN_SPINNER,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,97,81,11,12
    LTEXT           "Display format:",IDC_STATIC,19,100,47,8
    CONTROL         "ASCII",IDC_FORMAT_RADIOBUTTON_GROUP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,76,100,34,10
    CONTROL         "EBCDIC",IDC_EBCDIC_RADIOBUTTON,"Button",BS_AUTORADIOBUTTON,115,100,42,10
    DEFPUSHBUTTON   "OK",IDOK,63,129,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,120,129,50,14
END

IDD_BLOCKINFO_DIALOG DIALOGEX 0, 0, 336, 145
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Block Details"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    EDITTEXT        IDC_DETAILS_EDIT,7,7,322,110,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON   "OK",IDOK,142,124,50,14
END

IDD_GOTO_DIALOG DIALOGEX 0, 0, 205, 76
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
