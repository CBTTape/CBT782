			<Tool
				Name="VCPreBuildEventTool"
			/>
			<Tool
				Name="VCCustomBuildTool"
			/>
			<Tool
				Name="VCMIDLTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Running zipjobs.cmd ..."
				CommandLine="zipjobs.cmd &quot;$(SolutionDir)&quot;"
			/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<File
			RelativePath=".\src.WJF"
			>
		</File>
		<File
			RelativePath=".\winXXcpy.cmd"
			>
		</File>
		<File
			RelativePath=".\zipjobs.cmd"
			>
		</File>
	</Files>
	<Globals>
