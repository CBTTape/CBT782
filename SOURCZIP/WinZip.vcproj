	RootNamespace="WinZip"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="All|Win32"
			OutputDirectory=".\Release"
			IntermediateDirectory=".\Release"
			ConfigurationType="10"
			CharacterSet="0"
			DeleteExtensionsOnClean="*.zip;*temp.WJF"
			WholeProgramOptimization="1"
			BuildLogFile="$(IntDir)\ZipBuildLog.htm"
